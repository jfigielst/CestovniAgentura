<script>
document.addEventListener("DOMContentLoaded", function () {
    const radios = document.querySelectorAll(".termin-radio");
    const hiddenTerminText = document.getElementById("skryty-termin-text");

    function updateSelectedTermin() {
        const checkedRadio = document.querySelector(".termin-radio:checked");
        if (checkedRadio) {
            hiddenTerminText.value = checkedRadio.getAttribute("data-termin-text");
            // Odstranit aktivní třídu ze všech karet a přidat ji vybrané
            document.querySelectorAll(".termin-karta").forEach(k => k.classList.remove("aktivni"));
            checkedRadio.closest(".termin-karta").classList.add("aktivni");
        }
    }

    radios.forEach(radio => {
        radio.addEventListener("change", updateSelectedTermin);
    });

    // Spustíme inicializaci při načtení
    updateSelectedTermin();
});
</script>
