                                         <input type="hidden" name="id_terminu" value="<?= $hotel['id_terminu'] ?>">
                                         <input type="hidden" name="hotel" value="<?= htmlspecialchars($hotel['hotel']) ?>">
                                         <input type="hidden" name="termin" value="<?= date('d.m.Y', strtotime($hotel['datum_od'])) ?> – <?= date('d.m.Y', strtotime($hotel['datum_do'])) ?>">
