                <?php
                    // Určení cenové kategorie pro filter (nizka: < 15k, stredni: 15-30k, vysoka: > 30k)
                    $cenovaKategorie = 'nizka';
                    if ($z['cena'] >= 30000) {
                        $cenovaKategorie = 'vysoka';
                    } elseif ($z['cena'] >= 15000) {
                        $cenovaKategorie = 'stredni';
                    }
                    
                    // Určení délky pobytu (výpočet z prvního termínu)
                    $delkaPobytu = 7; // výchozí
                    if (!empty($z['terminy'])) {
                        $datetime1 = new DateTime($z['terminy'][0]['datum_od']);
                        $datetime2 = new DateTime($z['terminy'][0]['datum_do']);
                        $interval = $datetime1->diff($datetime2);
                        $delkaPobytu = $interval->days;
                    }
                ?>
                <div class="karta" data-zajezd data-destinace="<?= htmlspecialchars($z['id_destinace']) ?>" data-stat="<?= htmlspecialchars($z['stat']) ?>" data-cena="<?= $cenovaKategorie ?>" data-delka="<?= $delkaPobytu ?>">
