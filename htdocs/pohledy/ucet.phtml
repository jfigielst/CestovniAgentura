<script>
document.addEventListener("DOMContentLoaded", function () {
    const formHeslo = document.getElementById("form-zmena-hesla");
    if (formHeslo) {
        formHeslo.addEventListener("submit", function (e) {
            const heslo = formHeslo.querySelector('[name="nove_heslo"]').value;
            const potvrzeni = formHeslo.querySelector('[name="potvrzeni_hesla"]').value;
            if (heslo !== potvrzeni) {
                e.preventDefault();
                alert("Nová hesla se neshodují.");
            }
        });
    }
});
</script>