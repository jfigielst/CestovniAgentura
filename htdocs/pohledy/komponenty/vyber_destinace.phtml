<?php
/**
 * Komponenta pro výběr destinace/letiště
 * Očekává proměnné:
 * $prefix - unikátní ID prefix (např. 'dest', 'letiste', 'filtr-dest')
 * $nadpis - Nadpis okna
 * $placeholder - Placeholder pro vyhledávání
 * $data - Pole rozdělené podle států: ['Stát' => [['id_destinace' => 1, 'nazev_mesta' => 'Praha'], ...]]
 * $isMulti - boolean, true pro checkbox, false pro radio
 * $inputName - název inputu odesílaného ve formuláři (např. 'destinace[]' nebo 'id_destinace')
 * $defaultText - Výchozí text zobrazený na tlačítku
 * $hodnotaId - Klíč pro ID v poli $data (např. 'id_destinace' nebo 'iata')
 * $hodnotaNazev - Klíč pro název v poli $data (např. 'nazev_mesta' nebo 'mesto')
 */
?>
<div class="vyber-komponenta" data-prefix="<?= htmlspecialchars($prefix) ?>" data-multi="<?= $isMulti ? 'true' : 'false' ?>" data-default="<?= htmlspecialchars($defaultText) ?>">
    <div class="dest-trigger" id="<?= htmlspecialchars($prefix) ?>-trigger" tabindex="0">
        <span id="<?= htmlspecialchars($prefix) ?>-trigger-text"><?= htmlspecialchars($defaultText) ?></span>
    </div>

    <!-- Modal pro výběr -->
    <div id="<?= htmlspecialchars($prefix) ?>-modal" class="dest-modal">
        <div class="dest-modal__content">
            <div class="dest-modal__header">
                <h2 style="font-size: 1.25rem; margin: 0; color: var(--barva-modra);"><?= htmlspecialchars($nadpis) ?></h2>
                <button type="button" class="dest-modal__close" aria-label="Zavřít">×</button>
            </div>
            <div class="dest-modal__search">
                <input type="text" id="<?= htmlspecialchars($prefix) ?>-search" placeholder="<?= htmlspecialchars($placeholder) ?>">
            </div>
            <div class="dest-modal__grid">
                <?php foreach ($data as $stat => $mesta): ?>
                    <div class="dest-state-group" data-stat="<?= htmlspecialchars($stat) ?>">
                        <div class="dest-state-header">
                            <?php if ($isMulti): ?>
                                <label class="checkbox-container">
                                    <input type="checkbox" class="cb-stat" value="<?= htmlspecialchars($stat) ?>">
                                    <span class="checkmark"></span>
                                    <span class="stat-name"><?= htmlspecialchars($stat) ?></span>
                                </label>
                            <?php else: ?>
                                <span class="stat-name" style="font-weight: bold; margin-left: 10px;"><?= htmlspecialchars($stat) ?></span>
                            <?php endif; ?>
                            <button type="button" class="dest-expand-btn" aria-label="Rozbalit">v</button>
                        </div>
                        <div class="dest-cities">
                            <?php foreach ($mesta as $mesto): ?>
                                <label class="checkbox-container city-cb" style="font-weight: 400;">
                                    <?php if ($isMulti): ?>
                                        <input type="checkbox" class="cb-mesto" name="<?= htmlspecialchars($inputName) ?>" value="<?= htmlspecialchars($mesto[$hodnotaId]) ?>" data-nazev="<?= htmlspecialchars($mesto[$hodnotaNazev]) ?>">
                                        <span class="checkmark"></span>
                                    <?php else: ?>
                                        <input type="radio" class="cb-mesto" name="<?= htmlspecialchars($inputName) ?>" value="<?= htmlspecialchars($mesto[$hodnotaId]) ?>" data-nazev="<?= htmlspecialchars($mesto[$hodnotaNazev]) ?>" style="display:inline-block; margin-right: 8px;">
                                    <?php endif; ?>
                                    
                                    <?php 
                                        $zobrazenyNazev = $mesto[$hodnotaNazev];
                                        if (isset($mesto['iata'])) {
                                            $zobrazenyNazev .= ' (' . $mesto['iata'] . ')';
                                        }
                                        echo htmlspecialchars($zobrazenyNazev);
                                    ?>
                                </label>
                            <?php endforeach; ?>
                        </div>
                    </div>
                <?php endforeach; ?>
            </div>
            <div class="dest-modal__footer">
                <button type="button" class="tlacitko tlacitko--primarni dest-confirm-btn" id="<?= htmlspecialchars($prefix) ?>-confirm-btn">POTVRDIT A ZAVŘÍT</button>
            </div>
        </div>
    </div>
</div>
