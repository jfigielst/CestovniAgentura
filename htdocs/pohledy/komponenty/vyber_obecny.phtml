<?php
// Očekávané proměnné:
// $prefix - unikátní ID prefix
// $nadpis - nadpis modálu
// $data - pole klíč => hodnota pro options
// $isMulti - true/false pro vícenásobný výběr
// $inputName - atribut name
// $defaultText - výchozí text na tlačítku
?>
<div class="vyber-komponenta" data-prefix="<?= htmlspecialchars($prefix) ?>" data-multi="<?= $isMulti ? 'true' : 'false' ?>" data-default="<?= htmlspecialchars($defaultText) ?>">
    <!-- Viditelné tlačítko, které otevírá modál -->
    <div class="dest-trigger" id="<?= htmlspecialchars($prefix) ?>-trigger" tabindex="0">
        <span id="<?= htmlspecialchars($prefix) ?>-trigger-text"><?= htmlspecialchars($defaultText) ?></span>
    </div>

    <!-- Modál pro výběr -->
    <div id="<?= htmlspecialchars($prefix) ?>-modal" class="dest-modal">
        <div class="dest-modal__content">
            <div class="dest-modal__header">
                <h2 class="vyhledavani__modal-title"><?= htmlspecialchars($nadpis) ?></h2>
                <button type="button" class="dest-modal__close" aria-label="Zavřít">×</button>
            </div>
            <div class="dest-modal__body">
                <div class="dest-cities" style="display: block; margin-top: 1rem;">
                    <?php if (!$isMulti): ?>
                        <label class="checkbox-container city-cb checkbox-label-regular">
                            <input type="radio" class="cb-mesto cb-obecny" name="<?= htmlspecialchars($inputName) ?>" value="" data-nazev="<?= htmlspecialchars($defaultText) ?>" checked>
                            <span class="checkmark checkmark--radio"></span>
                            <?= htmlspecialchars($defaultText) ?>
                        </label>
                    <?php endif; ?>
                    
                    <?php foreach ($data as $hodnota => $stitek): ?>
                        <label class="checkbox-container city-cb checkbox-label-regular">
                            <?php if ($isMulti): ?>
                                <input type="checkbox" class="cb-mesto cb-obecny" name="<?= htmlspecialchars($inputName) ?>[]" value="<?= htmlspecialchars($hodnota) ?>" data-nazev="<?= htmlspecialchars($stitek) ?>">
                                <span class="checkmark"></span>
                            <?php else: ?>
                                <input type="radio" class="cb-mesto cb-obecny" name="<?= htmlspecialchars($inputName) ?>" value="<?= htmlspecialchars($hodnota) ?>" data-nazev="<?= htmlspecialchars($stitek) ?>">
                                <span class="checkmark checkmark--radio"></span>
                            <?php endif; ?>
                            <?= htmlspecialchars($stitek) ?>
                        </label>
                    <?php endforeach; ?>
                </div>
            </div>
            <div class="dest-modal__footer">
                <button type="button" class="tlacitko tlacitko--primarni dest-confirm-btn" id="<?= htmlspecialchars($prefix) ?>-confirm-btn">POTVRDIT A ZAVŘÍT</button>
            </div>
        </div>
    </div>
</div>
