<!-- JavaScript pro taby a editaci -->
<script>
function prejdiNaTab(tabId) {
    // Skryjeme panely
    document.querySelectorAll('.admin-panel').forEach(function (panel) {
        panel.classList.remove('aktivni');
    });

    // Zobrazíme vybraný
    const aktivniPanel = document.getElementById(tabId);
    if (aktivniPanel) {
        aktivniPanel.classList.add('aktivni');
    }

    // Třída na tlačítkách
    document.querySelectorAll('.tlacitko-tab').forEach(function (btn) {
        btn.classList.remove('aktivni-tab');
    });

    const aktivniTlacitko = document.getElementById('btn-' + tabId);
    if (aktivniTlacitko) {
        aktivniTlacitko.classList.add('aktivni-tab');
    }

    // Uchování tabu v session pro případ reloadu
    sessionStorage.setItem('aktivniAdminTab', tabId);
}

// Úprava zájezdu
function upravZajezd(z) {
    document.getElementById('form-zajezd-nadpis').textContent = 'Upravit zájezd: ' + z.hotel;
    document.getElementById('form-zajezd-akce').value = 'upravit';
    document.getElementById('form-zajezd-id').value = z.id_zajezdu;
    
    // Předvyplnění formuláře
    const form = document.querySelector('#tab-zajezdy form');
    form.querySelector('[name="hotel"]').value = z.hotel;
    
    // Předvyplnění pro naši novou modál komponentu (radio button)
    const destRadio = form.querySelector(`[name="id_destinace"][value="${z.id_destinace}"]`);
    if (destRadio) {
        destRadio.checked = true;
        const triggerText = document.getElementById('admin-dest-trigger-text');
        if (triggerText) {
            triggerText.textContent = destRadio.getAttribute('data-nazev');
        }
    }
    
    
    form.querySelector('[name="cena"]').value = z.cena;
    form.querySelector('[name="strava"]').value = z.strava;
    form.querySelector('[name="obrazky"]').value = z.obrazky;
    form.querySelector('[name="popis"]').value = z.popis;
    
    document.getElementById('btn-zajezd-submit').textContent = 'Uložit změny';
    document.getElementById('btn-zajezd-storno').classList.remove('skryte');
    
    // Plynulý posun k formuláři
    form.scrollIntoView({ behavior: 'smooth', block: 'center' });
}

function stornujUpravuZajezdu() {
    document.getElementById('form-zajezd-nadpis').textContent = 'Vytvořit nový zájezd';
    document.getElementById('form-zajezd-akce').value = 'pridat';
    document.getElementById('form-zajezd-id').value = '';
    
    const form = document.querySelector('#tab-zajezdy form');
    form.reset();
    
    // Reset zobrazeného textu v modální komponentě destinace
    const triggerText = document.getElementById('admin-dest-trigger-text');
    if (triggerText) triggerText.textContent = 'Vyberte destinaci';
    
    document.getElementById('btn-zajezd-submit').textContent = 'Přidat zájezd';
    document.getElementById('btn-zajezd-storno').classList.add('skryte');
}

// Úprava termínu
function upravTermin(t) {
    document.getElementById('form-termin-nadpis').textContent = 'Upravit termín';
    document.getElementById('form-termin-akce').value = 'upravit';
    document.getElementById('form-termin-id').value = t.id_terminu;
    
    // Předvyplnění formuláře
    const form = document.querySelector('#tab-terminy form');
    
    // Předvyplnění pro naši modální komponentu zájezdů (radio button)
    const zajezdRadio = form.querySelector(`[name="id_zajezdu"][value="${t.id_zajezdu}"]`);
    if (zajezdRadio) {
        zajezdRadio.checked = true;
        const triggerText = document.getElementById('admin-termin-zajezd-trigger-text');
        if (triggerText) {
            triggerText.textContent = zajezdRadio.getAttribute('data-nazev');
        }
    }

    // Předvyplnění pro naši modální komponentu letišť (radio button)
    const letisteRadio = form.querySelector(`[name="odlet_iata"][value="${t.odlet_iata || ''}"]`);
    if (letisteRadio) {
        letisteRadio.checked = true;
        const triggerText = document.getElementById('admin-termin-letiste-trigger-text');
        if (triggerText) {
            triggerText.textContent = letisteRadio.getAttribute('data-nazev');
        }
    } else {
        // Resetujeme na 'Vlastní doprava' pokud v termínu není letiště
        const emptyRadio = form.querySelector(`[name="odlet_iata"][value=""]`);
        if (emptyRadio) emptyRadio.checked = true;
        const triggerText = document.getElementById('admin-termin-letiste-trigger-text');
        if (triggerText) {
            triggerText.textContent = 'Vlastní doprava';
        }
    }

    form.querySelector('[name="datum_od"]').value = t.datum_od;
    form.querySelector('[name="datum_do"]').value = t.datum_do;
    form.querySelector('[name="kapacita"]').value = t.kapacita;
    
    document.getElementById('btn-termin-submit').textContent = 'Uložit změny';
    document.getElementById('btn-termin-storno').classList.remove('skryte');
    
    // Plynulý posun k formuláři
    form.scrollIntoView({ behavior: 'smooth', block: 'center' });
}

function stornujUpravuTerminu() {
    document.getElementById('form-termin-nadpis').textContent = 'Vypsat nový termín';
    document.getElementById('form-termin-akce').value = 'pridat';
    document.getElementById('form-termin-id').value = '';
    
    const form = document.querySelector('#tab-terminy form');
    form.reset();

    // Reset trigger textů
    const zajezdTriggerText = document.getElementById('admin-termin-zajezd-trigger-text');
    if (zajezdTriggerText) zajezdTriggerText.textContent = 'Vyberte zájezd';

    const letisteTriggerText = document.getElementById('admin-termin-letiste-trigger-text');
    if (letisteTriggerText) letisteTriggerText.textContent = 'Vlastní doprava';
    
    document.getElementById('btn-termin-submit').textContent = 'Uložit termín';
    document.getElementById('btn-termin-storno').classList.add('skryte');
}

// Obnovení aktivního tabu z paměti po načtení
document.addEventListener("DOMContentLoaded", function () {
    const ulozenyTab = sessionStorage.getItem('aktivniAdminTab');
    if (ulozenyTab) {
        prejdiNaTab(ulozenyTab);
    }
});
</script>
